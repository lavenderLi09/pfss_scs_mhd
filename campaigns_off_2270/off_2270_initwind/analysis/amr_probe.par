$AMRVAC_DIR/setup.pl -d=3 -arch=debug

&filelist
    base_filename='data/amr_probe'
    firstprocess=.false.
    saveprim=.false.
    autoconvert=.false.
/

&savelist
    ditsave_log=1
    itsave(1,1)=0
    itsave(1,2)=0
    itsave(2,1)=1
    itsave(2,2)=0
/

&stoplist
    reset_it=.true.
    reset_time=.true.
    it_max=1
    time_max=1.0d-6
/

&methodlist
    time_stepper='threestep'
    flux_scheme=20*'hll'
    limiter=20*'vanleer'
    small_density=1.0d-8
    small_pressure=1.0d-8
    small_values_method='replace'
    fix_small_values=.false.
    check_small_values=.true.
/

&boundlist
    typeboundary_min1=8*'special'
    typeboundary_max1=8*'special'
    typeboundary_min2=8*'pole'
    typeboundary_max2=8*'pole'
    typeboundary_min3=8*'periodic'
    typeboundary_max3=8*'periodic'
/

&meshlist
    refine_criterion=3
    refine_max_level=2
    refine_threshold=0.2d0,0.3d0,0.3d0,0.4d0,16*0.2d0
    derefine_ratio=20*0.1d0
    w_refine_weight(6)=0.4d0
    w_refine_weight(7)=0.3d0
    w_refine_weight(8)=0.3d0
    block_nx1=20
    block_nx2=16
    block_nx3=16
    domain_nx1=600
    domain_nx2=96
    domain_nx3=192
    xprobmin1=1.0d0
    xprobmax1=19.9932d0
    xprobmin2=0.0d0
    xprobmax2=0.5d0
    xprobmin3=0.0d0
    xprobmax3=1.0d0
    stretch_dim(1)='uni'
    qstretch_baselevel=1.008d0
    ditregrid=1
    max_blocks=40000
/

&paramlist
    typecourant='maxsum'
    courantpar=0.5d0
/

&mhd_list
    mhd_energy=.true.
    mhd_viscosity=.false.
    mhd_gravity=.true.
    mhd_gamma=1.05d0
    typedivbfix='glm'
    boundary_divbfix_skip(1)=1
    boundary_divbfix_skip(2)=1
    mhd_internal_e=.true.
    mhd_adiab=1.0d0
/
